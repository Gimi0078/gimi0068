{
  "name": "magazzino-elettrico",
  "version": "0.1.0-beta.1",
  "description": "Gestione magazzino per installatori elettrici",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Gimi0068",
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0"
  },
  "productName": "Magazzino Elettrico",
  "build": {
    "appId": "it.magazzino.elettrico",
    "productName": "Magazzino Elettrico",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MagazzinoElettrico-Setup-${version}.${ext}",
      "shortcutName": "Magazzino Elettrico"
    },
    "portable": {
      "artifactName": "MagazzinoElettrico-Portable-${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    },
    "publish": null
  }
}